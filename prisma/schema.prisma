generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Users (single-user v1, teams later) ──
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  companies Company[]
  events    InvoiceEvent[]
}

// ── Seller profiles ──
model Company {
  id                String   @id @default(cuid())
  ownerId           String
  legalName         String
  tradeName         String?
  address           String
  city              String?
  country           String   @default("MA")
  phone             String?
  email             String?
  website           String?
  defaultCurrency   String   @default("MAD")
  defaultTaxBps     Int      @default(2000) // 20%
  invoicePrefix     String   @default("FAC")
  avoirPrefix       String   @default("AV")
  devisPrefix       String   @default("DEV")
  invoiceLocale     String   @default("fr")
  accentColor       String   @default("#1D4ED8") // invoice theme accent (hex), user-customizable
  footerNotes       String?
  // Morocco legal (optional, first-class)
  ice               String?
  identifiantFiscal String?
  rc                String?
  rcCity            String?
  patente           String? // N° Taxe Professionnelle (obligatoire même en exonération)
  legalForm         String? // SARL | SA | SNC | AE | ...
  capitalSocial     Int? // minor units MAD, optional display
  cnss              String?
  taxRegime         String   @default("COMMUN") // COMMUN | AE_HORS_CHAMP (art.91-II-3°) | EXONERE_ART92
  // Bank (structured, optional)
  bankName          String?
  accountHolder     String?
  rib               String?
  iban              String?
  swift             String?
  logoPath          String?
  signaturePath     String?
  whatsappEnabled   Boolean  @default(false)
  whatsappTemplate  String?
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  series   NumberingSeries[]
  recurringTemplates RecurringTemplate[]

  @@index([ownerId])
}

// Per-company per-year numbering series (prefix configurable → series-ready)
model NumberingSeries {
  id        String @id @default(cuid())
  companyId String
  prefix    String @default("FAC")
  year      Int
  lastNo    Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, prefix, year])
  @@index([companyId])
}

// ── Buyers ──
model Client {
  id              String   @id @default(cuid())
  ownerId         String
  type            String   @default("COMPANY") // PERSON | COMPANY
  name            String // person name or contact name
  companyName     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String   @default("MA")
  ice             String?
  clientIF        String?
  clientRC        String?
  isAssujetti     Boolean  @default(true) // false = particulier B2C, ICE non requis
  defaultCurrency String   @default("MAD")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices Invoice[]
  recurringTemplates RecurringTemplate[]

  @@index([ownerId])
}

// ── Invoice (DRAFT mutable, ISSUED immutable) ──
model Invoice {
  id                    String    @id @default(cuid())
  ownerId               String
  companyId             String?
  clientId              String?
  status                String    @default("DRAFT") // DRAFT | ISSUED | CANCELLED
  docType               String    @default("FACTURE") // FACTURE | AVOIR | RECTIFICATIVE (own AV-series, linked)
  linkedInvoiceId       String? // original invoice for AVOIR / RECTIFICATIVE ("annule et remplace")
  correctionReason      String? // motif obligatoire pour AVOIR/RECTIFICATIVE
  validUntil            DateTime? // devis: validity date (default issue + 30d)
  quoteStatus           String? // devis: PENDING | ACCEPTED | REFUSED | EXPIRED
  convertedInvoiceId    String? // devis → resulting FACTURE id
  invoiceNumber         String? // null until finalized; unique per company (two companies may share FAC-2026-0001)
  currency              String    @default("MAD")
  invoiceLocale         String    @default("fr")
  issueDate             DateTime  @default(now())
  dueDate               DateTime?
  paymentTerms          String    @default("CUSTOM") // ON_RECEIPT | D7 | D15 | D30 | D60 | CUSTOM
  paymentMode           String? // ESPECES | VIREMENT | CHEQUE | EFFET | ... (mention obligatoire MA)
  taxMention            String? // ex. "TVA non applicable — art. 91-II-3° CGI" (AE) / "Exonéré — art. 92"
  amountInWords         String? // "Arrêté la présente facture à la somme de ..." (usage MA, frozen)
  poNumber              String?
  clientRef             String?
  projectRef            String?
  notes                 String?
  footerText            String?
  // discounts (invoice level)
  invDiscountBps        Int       @default(0)
  invDiscountFixedMinor Int       @default(0)
  // snapshots frozen at finalize (JSON strings)
  sellerSnapshot        String?
  buyerSnapshot         String?
  linesSnapshot         String? // frozen lines JSON for legal reproduction
  // totals (minor units, computed by domain calculator at finalize + on payment)
  subtotalHT            Int       @default(0)
  totalTVA              Int       @default(0)
  totalTTC              Int       @default(0)
  taxBreakdown          String? // JSON [{rateBps, taxable, tax}]
  // share / send
  publicToken           String?   @unique
  publicTokenExpiresAt  DateTime?
  sentAt                DateTime?
  sentTo                String?
  whatsappStatus        String    @default("NOT_SENT") // NOT_SENT | SENDING | SENT | FAILED
  whatsappSentAt        DateTime?
  whatsappSentTo        String?
  whatsappMessageId     String?
  whatsappError         String?
  whatsappLastAttemptAt DateTime?
  viewedAt              DateTime?
  finalizedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  linkedInvoice   Invoice?       @relation("CorrectionLink", fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  corrections     Invoice[]      @relation("CorrectionLink")
  lines           InvoiceLine[]
  payments        Payment[]
  events          InvoiceEvent[]
  reminders  Reminder[]
  reconciliations AvoirInvoice[] @relation("InvoiceRef")
  avoirInvoices AvoirInvoice[] @relation("AvoirRef")
  lastGeneratedRecurring RecurringTemplate[] @relation("RecurringLastGen")

  @@unique([companyId, invoiceNumber])
  @@index([ownerId, status])
  @@index([companyId])
  @@index([clientId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  position       Int     @default(0)
  description    String
  quantityMilli  Int     @default(1000) // 1000 = 1.000
  unit           String  @default("piece") // piece|hour|day|kg|service|...
  unitPriceMinor Int // HT, minor units
  discountBps    Int     @default(0) // 0..10000
  taxRateBps     Int     @default(2000)
  taxExempt      Boolean @default(false)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  amountMinor Int
  currency    String
  paymentDate DateTime @default(now())
  method      String   @default("BANK_TRANSFER") // CASH|BANK_TRANSFER|CARD|CHECK|OTHER
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  actorId   String?
  type      String // created|finalized|sent|viewed|payment_recorded|paid|cancelled|duplicated
  metadata  String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([invoiceId, type])
}

// ── Product/service library (v1: reuse lines, no stock) ──
model Product {
  id             String   @id @default(cuid())
  ownerId        String
  companyId      String?
  name           String
  description    String?
  unit           String   @default("piece")
  unitPriceMinor Int // HT, minor units
  taxRateBps     Int      @default(2000)
  taxExempt      Boolean  @default(false)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
}

// ── Recurring invoice templates ──
model RecurringTemplate {
  id                    String   @id @default(cuid())
  ownerId               String
  name                  String
  companyId             String?
  clientId              String?
  docType               String   @default("FACTURE") // FACTURE | DEVIS
  currency              String   @default("MAD")
  paymentTerms          String   @default("D30")
  periodDays            Int      @default(30)
  startDate             DateTime
  lines                 String   // JSON
  lastGeneratedAt       DateTime?
  lastGeneratedInvoiceId String?
  nextRunAt             DateTime?
  autoSend              Boolean  @default(false)
  sendChannel           String   @default("NONE") // NONE | EMAIL | WHATSAPP
  lastError             String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lastGeneratedInvoice Invoice? @relation("RecurringLastGen", fields: [lastGeneratedInvoiceId], references: [id])

  @@index([ownerId])
  @@index([ownerId, active])
  @@index([active, nextRunAt])
}

// ── Overdue reminders (relances) ──
model Reminder {
  id          String    @id @default(cuid())
  ownerId     String
  invoiceId   String
  type        String    @default("OVERDUE") // OVERDUE | BEFORE_DUE
  channel     String    @default("WHATSAPP") // WHATSAPP
  sentAt      DateTime?
  scheduledAt DateTime
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([ownerId, scheduledAt])
  @@index([invoiceId])
  @@index([sentAt, scheduledAt])
}

// ── Team members (v1: owner/admin/viewer) ──
model Member {
  id          String    @id @default(cuid())
  ownerId     String
  userId      String?   @unique
  email       String
  displayName String?
  role        String    @default("VIEWER") // OWNER | ADMIN | VIEWER
  inviteToken String?   @unique
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?

  employee Employee?

  @@unique([ownerId, email])
  @@index([ownerId])
}

model AvoirInvoice {
  id          String  @id @default(cuid())
  ownerId     String
  avoirId     String
  invoiceId   String
  amountMinor Int
  createdAt   DateTime @default(now())

  avoir  Invoice @relation("AvoirRef", fields: [avoirId], references: [id], onDelete: Cascade)
  invoice Invoice @relation("InvoiceRef", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([avoirId])
  @@index([invoiceId])
}

// ── User-defined rates / charges (country-agnostic: CNSS, insurance, taxes…) ──
model Rate {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  kind       String   @default("PERCENT") // PERCENT | FIXED
  percentBps Int      @default(0) // e.g. 2100 = 21%
  fixedMinor Int      @default(0)
  capMinor   Int? // optional ceiling
  appliesTo  String   @default("ANY") // ANY | EMPLOYER | EMPLOYEE | EXPENSE
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

// ── Expenses (outgoings, optional charges, billable to a client) ──
model Expense {
  id             String   @id @default(cuid())
  ownerId        String
  companyId      String?
  clientId       String?
  invoiceId      String?
  supplier       String?
  category       String?
  description    String
  date           DateTime @default(now())
  amountHTMinor  Int      @default(0)
  taxRateBps     Int      @default(2000)
  taxExempt      Boolean  @default(false)
  charges        String? // JSON [{rateId,name,amountMinor}]
  totalMinor     Int      @default(0) // HT + TVA + charges
  currency       String   @default("MAD")
  paymentMethod  String   @default("BANK_TRANSFER")
  reference      String?
  billable       Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId, date])
  @@index([companyId])
}

// ── Payroll: employees + payslips (user-defined employer/employee rates) ──
model Employee {
  id               String   @id @default(cuid())
  ownerId          String
  memberId         String?  @unique // optional link to a team member (login)
  fullName         String
  position         String?
  grossSalaryMinor Int      @default(0)
  currency         String   @default("MAD")
  active           Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  payslips Payslip[]

  @@index([ownerId])
  @@index([memberId])
}

model Payslip {
  id                  String    @id @default(cuid())
  ownerId             String
  employeeId          String
  period              String // YYYY-MM
  grossMinor          Int
  currency            String    @default("MAD")
  employerCharges     String? // JSON [{rateId,name,amountMinor}]
  employeeDeductions  String? // JSON [{rateId,name,amountMinor}]
  employerCostMinor   Int       @default(0)
  netMinor            Int       @default(0)
  status              String    @default("DRAFT") // DRAFT | PAID
  paidAt              DateTime?
  expenseId           String?
  notes               String?
  createdAt           DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([ownerId, period])
  @@index([employeeId])
}

// ── Money accounts (bank / cash) + ledger entries ──
model Account {
  id                  String   @id @default(cuid())
  ownerId             String
  companyId           String?
  name                String
  kind                String   @default("BANK") // BANK | CASH
  currency            String   @default("MAD")
  openingBalanceMinor Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  entries LedgerEntry[]

  @@index([ownerId])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  ownerId     String
  accountId   String
  date        DateTime @default(now())
  direction   String // IN | OUT
  amountMinor Int
  currency    String   @default("MAD")
  label       String
  category    String?
  invoiceId   String?
  expenseId   String?
  note        String?
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([ownerId, date])
  @@index([accountId])
}

// ── Client contracts / agreements ──
model Contract {
  id           String    @id @default(cuid())
  ownerId      String
  companyId    String?
  clientId     String
  title        String
  valueMinor   Int       @default(0) // agreed amount (HT) over the period
  currency     String    @default("MAD")
  periodDays   Int       @default(30)
  taxRateBps   Int       @default(2000)
  paymentTerms String    @default("D30")
  startDate    DateTime  @default(now())
  endDate      DateTime?
  active       Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId])
  @@index([clientId])
}
