generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/hub-client"
}

datasource db {
  provider = "sqlite"
  url      = env("HUB_DATABASE_URL")
}

model SuperAdmin {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  displayName  String      @default("Admin")
  createdAt    DateTime    @default(now())
  sessions     HubSession[]
  approvedTenants Tenant[]
  auditLogs    AuditLog[]
}

model HubSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model Tenant {
  id            String   @id @default(cuid())
  email         String
  phone         String?
  companyName   String
  subdomain     String   @unique
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  deploymentId  String?  // Dokploy deployment ID
  supportKey    String?  // Generated on approval
  adminNotes    String?
  createdAt     DateTime @default(now())
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    SuperAdmin? @relation(fields: [approvedById], references: [id])

  @@index([email])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     SuperAdmin @relation(fields: [adminId], references: [id])
  action    String   // APPROVE_TENANT | REJECT_TENANT | SUPPORT_ACCESS | etc.
  details   String?  // JSON payload
  createdAt DateTime @default(now())

  @@index([adminId])
}