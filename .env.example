DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-32-chars-minimum"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Timezone used to display dates server-side (set per business/deployment).
TZ="Africa/Casablanca"
# WhatsApp (needs Chromium + persistent session storage; sessions stay server-side)
# Country code used to convert local numbers (0643213050 → 212643213050).
DEFAULT_COUNTRY_CODE="212"
WHATSAPP_SESSION_DIR="./data/whatsapp"
WHATSAPP_CLIENT_ID="invoice-platform"
WHATSAPP_CHROME_PATH=""
WHATSAPP_HEADLESS="true"
WHATSAPP_READY_TIMEOUT_MS="120000"
# Puppeteer protocol timeout (ms). Raise if WhatsApp Web init times out.
WHATSAPP_PROTOCOL_TIMEOUT_MS="180000"
# Cool-down after a failed start so we never launch several Chromium instances.
WHATSAPP_START_BACKOFF_MS="90000"
# Demo seed (optional, off by default). With SEED_ON_BOOT=1 the container
# tops up companies/clients to the targets below on startup — never deletes.
SEED_ON_BOOT="0"
SEED_OWNER_EMAIL="naoufal@naoufal.com"
SEED_COMPANIES="3"
SEED_CUSTOMERS="5"
# Automation (recurring invoices + reminders). The worker calls /api/cron.
CRON_SECRET=""
SCHEDULER_ENABLED="true"
SCHEDULER_INTERVAL_MS="300000"

# ── Platform admin (hub) ──
# Deployment role: full | hub | admin | router | tenant (default: full)
#   hub    = admin console + public register/sign-in in one container
#   admin  = admin console + hub API only
#   router = public register/sign-in lookup only (calls the admin's hub API)
#   tenant = pure invoicing app (no admin, no register)
APP_ROLE="full"
HUB_ADMIN_EMAIL="admin@invora.app"
HUB_ADMIN_PASSWORD="change-me"
# Only for APP_ROLE=router: where to reach the admin's hub API + shared secret.
HUB_API_URL="https://invoice.naoufalelouahabi.com"
HUB_API_SECRET=""

# ── Tenant provisioning (Dokploy) ──
DOKPLOY_URL="https://dokploy.example.com"
DOKPLOY_TOKEN=""
DOKPLOY_ENVIRONMENT_ID=""
DOKPLOY_SERVER_ID=""
DOKPLOY_GITHUB_OWNER=""
DOKPLOY_GITHUB_REPOSITORY="invoice-platform"
DOKPLOY_GITHUB_BRANCH="main"
DOKPLOY_GITHUB_ID=""
# Tenant hostname template. {slug} is replaced with the tenant slug.
# Use a FIRST-level subdomain ({slug}-invoice.example.com) so Cloudflare's free
# Universal SSL (*.example.com) covers it; {slug}.invoice.example.com needs Total TLS.
TENANT_DOMAIN_TEMPLATE="{slug}-invoice.naoufalelouahabi.com"
TENANT_PORT="3007"
# Estimated activation time shown in the approval notification.
TENANT_ACTIVATION_ETA="30 minutes"

# ── Support access (tenant side) ──
# Set per tenant deployment; enables /api/support-login read-only sessions.
SUPPORT_KEY=""

# ── Notifications (optional) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ── Diagnostics (optional; /api/debug disabled unless set) ──
DEBUG_KEY=""
