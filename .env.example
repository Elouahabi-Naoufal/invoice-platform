DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-32-chars-minimum"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Email (optional — without SMTP, send fails explicitly and invoice is NOT marked sent)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="facturation@example.ma"
# WhatsApp (optional — needs Chromium + persistent session storage; sessions stay server-side)
WHATSAPP_SESSION_DIR="./data/whatsapp"
WHATSAPP_CLIENT_ID="invoice-platform"
WHATSAPP_CHROME_PATH=""
WHATSAPP_HEADLESS="true"
WHATSAPP_READY_TIMEOUT_MS="120000"
# Demo seed (optional, off by default). With SEED_ON_BOOT=1 the container
# tops up companies/clients to the targets below on startup — never deletes.
# Set in Dokploy env, redeploy once, then remove it.
SEED_ON_BOOT="0"
SEED_OWNER_EMAIL="naoufal@naoufal.com"
SEED_COMPANIES="3"
SEED_CUSTOMERS="5"
